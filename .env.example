# ============================================================
# CivicMind — environment configuration (example)
# Copy to .env (gitignored) or set real environment variables on your host.
# Domain data (city, categories, wards, asset types, risk rules) lives in
# data/civicmind_config.json, not here.
# ============================================================

# --- Sarvam AI (optional) ------------------------------------
# Without a key CivicMind uses its rule-based engine for everything.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_TIMEOUT=25
# CIVICMIND_DISABLE_AI=1           # force rule-based mode even if a key is set

# --- Voice descriptions (speech-to-text uses the Sarvam key above) ---
SARVAM_STT_MODEL=saaras:v4
# CIVICMIND_VOICE_RETENTION_DAYS=90        # audio deleted this long after the complaint is resolved
# CIVICMIND_VOICE_UNLINKED_TTL_HOURS=24    # recordings never attached to a complaint

# --- Address search + "Use my current location" autofill (OFF by default; ON in run_demo.*) ---
# The public Nominatim service may be used only within its policy:
# https://operations.osmfoundation.org/policies/nominatim/ (max 1 request/s per app,
# identifying User-Agent, caching, attribution, explicit user action, no autocomplete).
# CIVICMIND_REVERSE_GEOCODER=nominatim     # or: none
# CIVICMIND_REVERSE_GEOCODER_USER_AGENT=CivicMind/0.5 (your-contact-or-site)

# --- Report photos/videos (1-3 per report) ---
# CIVICMIND_MEDIA_MAX_VIDEO_BYTES=31457280   # 30 MB
# CIVICMIND_MEDIA_MAX_VIDEO_SECONDS=30

# --- TinyFish (public data-source discovery for admins) -------
# Server-side only. Put the real key in .env (gitignored), never in code, docs or the browser.
# Without a key the app runs normally and the Data sources page reports "not configured".
TINYFISH_API_KEY=
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
TINYFISH_AGENT_URL=https://agent.tinyfish.ai
TINYFISH_TIMEOUT_SECONDS=30
TINYFISH_MAX_FETCH_URLS=10
TINYFISH_CACHE_TTL_SECONDS=900
# Agent (metered browser automation) stays OFF until pricing/limits are confirmed.
TINYFISH_ENABLE_AGENT=false
TINYFISH_AGENT_DAILY_LIMIT=5
TINYFISH_AGENT_MAX_DURATION_SECONDS=120
# TINYFISH_AGENT_ALLOWED_DOMAINS=pmc.gov.in    # extra domains besides selected candidates
# TINYFISH_AGENT_MAX_STEPS=                     # beta-gated by TinyFish; leave unset unless enabled
# Fictional, clearly labelled responses for local demos/tests only. Never true in production.
TINYFISH_MOCK_MODE=false

# --- Security -----------------------------------------------
# "production" refuses to start without a fixed CIVICMIND_SECRET (32+ chars), with demo mode,
# on the demo database or with TinyFish mock mode. The Docker image sets it by default.
CIVICMIND_ENV=development
# Leave blank locally to auto-generate backend/.secret_key. Set a long random
# value in production (changing it signs everyone out).
CIVICMIND_SECRET=
CIVICMIND_TOKEN_TTL_HOURS=12
# CIVICMIND_CORS_ORIGINS=           # comma-separated; empty = same-origin only

# Create an admin on first start if it does not exist (password >= 12 chars).
# CIVICMIND_ADMIN_EMAIL=
# CIVICMIND_ADMIN_PASSWORD=

# --- Paths (optional) ---------------------------------------
# CIVICMIND_DB=./backend/civicmind.db
# CIVICMIND_EVIDENCE_DIR=./private/evidence
# CIVICMIND_CONFIG=./data/civicmind_config.json

# --- Demo ---------------------------------------------------
# Set by run_demo.*; marks a local demo run. Never set it in production (start-up is refused).
# CIVICMIND_DEMO_MODE=1
# Optional shared password for seed_demo.py (otherwise random per account).
# CIVICMIND_DEMO_PASSWORD=
