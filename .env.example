# ============================================================
# CivicMind — environment configuration (example)
# Copy this to  .env  and fill in your values, OR set these as
# real environment variables on your host (recommended).
#
# Domain data (city, categories, wards, demo accounts) is NOT here —
# it lives in  data/civicmind_config.json.
# ============================================================

# --- Sarvam AI (optional but recommended) -------------------
# Get a key at https://dashboard.sarvam.ai  ->  API Keys.
# If left blank, CivicMind runs on its built-in rule-based engine.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-105b

# --- Security -----------------------------------------------
# Leave blank to auto-generate and persist a strong secret.
# Set a long random string in production.
CIVICMIND_SECRET=
CIVICMIND_TOKEN_TTL_HOURS=72

# --- Paths (optional) ---------------------------------------
# CIVICMIND_CONFIG=./data/civicmind_config.json
# CIVICMIND_DB=./backend/civicmind.db
